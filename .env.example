# PowerShell does not automatically load this file. See README.
REGISTRY_DATABASE_URL=sqlite:///./registry.db
REGISTRY_TTL_SECONDS=30
REGISTRY_HEARTBEAT_SECONDS=10
REGISTRY_URL=http://127.0.0.1:8000
WEATHER_ENDPOINT=http://127.0.0.1:8001/forecast
WEATHER_AGENT_ID=weather-local
WEATHER_CREDENTIAL_FILE=weather.credential

# Optional: heartbeat < suspect < TTL; default midpoint when omitted
REGISTRY_SUSPECT_SECONDS=20
AGENT_RETRY_MAX_SECONDS=10

NEWS_AGENT_ID=news-agent-01
NEWS_ENDPOINT=http://127.0.0.1:8002/invoke
NEWS_CREDENTIAL_FILE=news.credential
